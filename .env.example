# Supabase project credentials (Settings → API in the Supabase dashboard).
# Copy to .env (gitignored). Leave unset to run the app local-only — every
# feature except sync works without a backend.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Looping exercise demo clips. By default the app serves them from the bundled
# folder public/assets/demos/ (file named after each exercise id, e.g. bench.mp4).
# To serve them off-repo instead — keeps the deploy small — host them in the
# Supabase Storage public bucket `demos` (auto-detected from the URL above), or
# point at any CDN. Override source/format here:
# VITE_DEMO_VIDEO_BASE=https://your-cdn.example.com/demos   # any base URL
# VITE_DEMO_VIDEO_EXT=webm                                   # default: mp4
